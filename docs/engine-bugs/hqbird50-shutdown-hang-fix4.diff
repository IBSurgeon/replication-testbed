--- src/jrd/jrd.cpp.1878fix
+++ src/jrd/jrd.cpp
@@ -8091,6 +8091,18 @@
 	// Since that moment dbb becomes not reusable
 	dbb->dbb_init_fini->destroy();
 
+	// System attachments (garbage collector, cache writer, workers) are stopped
+	// below, and the garbage collector commits its transaction on exit. They
+	// must take no new trace sessions now: the mapping for a new session can
+	// wait for a lock (populateMutex of the mapping cache, spCache) held by
+	// this thread, which waits for them to finish.
+	{ // scope
+		SyncLockGuard sysGuard(&dbb->dbb_sys_attach, SYNC_SHARED, FB_FUNCTION);
+
+		for (Jrd::Attachment* att = dbb->dbb_sys_attachments; att; att = att->att_next)
+			att->att_trace_manager->stopNewSessions();
+	}
+
 	fb_assert(!dbb->locked());
 
 	WorkerAttachment::shutdownDbb(dbb);
